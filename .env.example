# ─────────────────────────────────────────────
# Vantaverse AI Builder Lab — Environment Config
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Neon Postgres)
# Get this from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/vantaverse?sslmode=require"

# Auth session secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Encrypts participants' own AI API keys at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=""

# Admin login (bootstrap credentials — run `pnpm db:seed` to create this user)
ADMIN_EMAIL="admin@vantaverse.ai"
ADMIN_SEED_PASSWORD=""

# GitHub OAuth App (for "Connect GitHub" builder evidence step)
# Create at https://github.com/settings/developers
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google Gemini API — ADMIN-ONLY FALLBACK.
# Builders bring their own key (saved encrypted from their Profile page)
# for self-service AI analysis and the chat assistant. This env key is
# only ever used when an admin manually runs analysis for a builder who
# hasn't added their own. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# SMTP (transactional email — OTP, Builder Report, assignments)
# SMTP_HOST is the mail SERVER hostname, not your email address —
# e.g. for Gmail: smtp.gmail.com (SMTP_USER is your address, with an
# App Password in SMTP_PASSWORD, not your normal Gmail password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Vantaverse AI Builder Lab <no-reply@vantaverse.ai>"

# Object storage for generated Builder Cards / reports (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
